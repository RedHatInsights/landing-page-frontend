{
  "version": 1,
  "tmsConfig": ".github/i18n/phrase-tms.json",
  "checks": [
    {
      "source": {
        "path": "translations/messages.json",
        "adapter": "formatjs-json",
        "locale": "en"
      },
      "targets": []
    }
  ],
  "generated": [
    {
      "path": "translations/messages.json",
      "adapter": "formatjs-json",
      "role": "source",
      "locale": "en",
      "command": "npm",
      "args": [
        "run",
        "--silent",
        "extract:messages",
        "--",
        "--out-file",
        "{output}"
      ],
      "updateCommand": "npm run extract:messages"
    }
  ],
  "sourceLint": {
    "files": [
      "src/**/*.{js,jsx,ts,tsx}"
    ]
  },
  "catalogDirectories": [
    {
      "path": "translations"
    },
    {
      "path": "messages"
    }
  ]
}
