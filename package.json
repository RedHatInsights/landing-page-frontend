    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@vitest/browser-playwright": "^4.1.12",
    "cypress": "^13.17.0",
    "cypress-localstorage-commands": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-storybook": "^10.6.3",
    "happy-dom": "^21.0.3",
    "identity-obj-proxy": "^3.0.0",
    "msw": "^2.15.0",
